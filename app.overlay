/*
 * Консоль переведена на SEGGER RTT (Channel 0).
 * USB CDC ACM узлы убраны, т.к. в prj.conf отключён USB device stack.
 *
 * Кнопка sw0 НЕ описывается здесь: алиас уже определён в базовом DTS
 * платы WeAct STM32WB55 Core и указывает на boot_button (PH3,
 * GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN). DT_ALIAS(sw0) в main.c получит
 * именно эту кнопку.
 */

/ {
     aliases {
         led1 = &led1;       /* новый алиас, led0 не трогаем */
         sw1 = &sw1;         /* кнопка Copy (Ctrl+C)  на PB6 */
         sw2 = &sw2;         /* кнопка Paste (Ctrl+V) на PB7 */
     };


     /*
      * Две дополнительные кнопки sw1/sw2 (gpio-keys).
      * sw0 уже определён в базовом DTS платы (boot_button PH3).
      *
      * PB6/PB7 выбраны т.к. их EXTI-линии (6,7) гарантированно свободны
      * (EXTI0/1 на PA0/PA1 заняты ADC/wkup-pin и вызывают -EBUSY).
      *
      * wakeup-source намеренно опущен: в Zephyr 4.4 binding gpio-keys
      * не наследует это свойство из pm.yaml. На STM32WB55 EXTI-прерывания
      * от GPIO аппаратно пробуждают CPU из STOP0/1/2 без DT-флага.
      */
     buttons {
         compatible = "gpio-keys";
         sw1: button_1 {
             gpios = <&gpiob 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
             label = "Copy Button (Ctrl+C)";
         };
         sw2: button_2 {
             gpios = <&gpiob 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
             label = "Paste Button (Ctrl+V)";
         };
     };
     leds {
        /* led0 не описываем — он уже есть в основном DTS */
        led1: led_1 {
            gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
            label = "User LED 1";
        };
    };
};

/* ====================================================================== *
 *  Отключение неиспользуемой периферии (снижение утечек и тактирования)    *
 *                                                                         *
 *  В базовом DTS платы включены узлы, которые не нужны данному            *
 *  приложению (HID-клавиатура): USB, I2C1, SPI1, ADC1, PWM-таймеры,       *
 *  LPUART1. Каждый активный узел = потребление из-за тактирования и       *
 *  утечек даже когда не используется. Отключаем status="disabled".        *
 * ====================================================================== */

/* USB device stack не используется (консоль через RTT) */
&usb { status = "disabled"; };

/* I2C1 не используется (PB8 занят led1, см. Project_NOTES.md §14.7) */
&i2c1 { status = "disabled"; };

/* SPI1 не используется внешними устройствами */
&spi1 { status = "disabled"; };

/* LPUART1 не используется (bt-mon/bt-c2h не нужны в production) */
&lpuart1 { status = "disabled"; };

/* PWM-таймеры не нужны (светодиод управляется GPIO напрямую) */
&timers1 { status = "disabled"; };
&timers2 { status = "disabled"; };

/* vref/vbat: ADC-зависимые узлы, не нужны без ADC */
&vref { status = "disabled"; };
&vbat { status = "disabled"; };
&die_temp { status = "disabled"; };

/* ====================================================================== *
 *  Освобождаем PA0/PA1 от ADC1 и wkup-pins                                *
 *                                                                         *
 *  В базовом DTS платы PA0/PA1 настроены как аналоговые входы ADC1.        *
 *  Также PA0/EXTI0 занят wkup-pin@1 (wakeup из sleep), что вызывает        *
 *  -EBUSY при настройке прерываний GPIO.                                   *
 *  Отключаем ADC1 и удаляем wkup-pins, освобождая PA0/PA1.                 *
 * ====================================================================== */
&adc1 {
    status = "disabled";
    /delete-property/ pinctrl-0;
    /delete-property/ pinctrl-names;
};

/* Отключаем wakeup-pins на PA0 (wkup-pin@1, EXTI0) и PA2 (wkup-pin@4, EXTI2),
 * чтобы освободить EXTI-линии для прерываний GPIO кнопок.
 * Узлы wkup-pin не имеют label, обращаемся по полному пути.
 */
&{/soc/power@58000400/wkup-pin@1} { status = "disabled"; };
&{/soc/power@58000400/wkup-pin@4} { status = "disabled"; };